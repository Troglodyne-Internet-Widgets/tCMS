# What the site writes: config/main.cfg, config/auth.db, the flags has_users and
# setup, and config/secrets.key, the vault key, when bin/tcms-vault-key --file
# put one here rather than the service handing one over.  Committing the key
# would put it in the same place as everything it protects.  The defaults that
# tCMS ships are in share/.
config/
Makefile
MYMETA.yml
MYMETA.json
node_modules/
www/statics/
totp/
fail2ban/tcms-jail.conf
logs/
run/
*-shm
*-wal
.xslate_cache/
*.swn
cover_db/
# What dzil build leaves at the root.  Anchored, or the pattern also hides a
# test named after the distribution, such as t/tCMS-Foo.t.
.build
/tCMS-*
