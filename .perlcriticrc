# Troglodyne perlcritic policy, for a distribution that declares use 5.040 or
# later.
#
# There are two of these.  This one is for code that runs on a perl you control,
# and perlcriticrc.compat is for code that runs on whatever perl is already
# installed.  The packaging-perl skill asks which you are writing before it
# copies one, because the answer decides more than this file: it decides the
# use line in every module and test, and perl: in prereqs.yml.
#
# The difference between the two is five policies.  A modern perl refuses what
# they report, so naming them here would buy nothing:
#
#   TestingAndDebugging::RequireUseStrict       strict is on from 5.012
#   Objects::ProhibitIndirectSyntax             no indirect from 5.036
#   InputOutput::ProhibitBarewordFileHandles    no bareword_filehandles from
#   InputOutput::ProhibitBarewordDirHandles       5.038
#   Modules::RequireEndWithOne                  module_true from 5.038
#
# Two more go the same way at 5.042.  They stay below because this file assumes
# only 5.040, and at a later floor they report nothing, so they cost nothing:
#
#   Variables::ProhibitPerl4PackageNames        no apostrophe as a package
#                                                 separator from 5.042
#   CodeLayout::RequireASCII                    source::encoding "ascii" from
#                                                 5.042, which is stricter than
#                                                 the policy and not skippable
severity  = 1
only      = 1
force     = 0
verbose   = 1
criticism-fatal = 1
color     = 1
allow-unsafe = 1
# Usability
[Modules::RequirePerlVersion]
[Documentation::RequirePod]
# Security
[ValuesAndExpressions::PreventSQLInjection]
# It also applies to POD, where the only thing it tends to catch is a
# contributor's name in the section that Dist::Zilla generates.
[CodeLayout::RequireASCII]
[RegularExpressions::RequireDefault]
strict = 1
[RegularExpressions::PreventUselessMetacharacterEscapes]
# A pattern written as a string loses the modifiers that RequireDefault asks for.
[RegularExpressions::ProhibitRegexInStrings]
# PEBCAK catches
[BuiltinFunctions::ProhibitDeleteOnArrays]
[Subroutines::ProhibitAmbiguousFunctionCalls]
[ValuesAndExpressions::ProhibitSingleArgArraySlice]
[ValuesAndExpressions::ProhibitDefinedBeforeLength]
[Variables::ProhibitUselessVarClearing]
[Subroutines::ProhibitTailRecursion]
[-ValuesAndExpressions::ProhibitDescendingRanges]
[Bangs::ProhibitUselessRegexModifiers]
[-RegularExpressions::ProhibitIneffectiveModifiers]
# The @example tag of a blurb that Pod::Coverage::More::Blurb reads is code in a
# comment on purpose: the generated POD shows it as the example of the sub.
# The pattern is the default of the policy, anchored, and refusing those lines.
[Bangs::ProhibitCommentedOutCode]
commentedcoderegex = \A(?!\#\s*\@example\b).*\$[A-Za-z_].*=
[Tics::ProhibitUseBase]
[Plicease::ProhibitLeadingZeros]
[RegularExpressions::ProhibitEmptyAlternatives]
[ValuesAndExpressions::UnexpandedSpecialLiteral]
[CodeLayout::ProhibitIfIfSameLine]
[ValuesAndExpressions::ConstantBeforeLt]
[ValuesAndExpressions::ProhibitDuplicateHashKeys]
# any access checks are necessarily a TOCTOU waiting to happen
[ValuesAndExpressions::ProhibitFiletest_f]
[ValuesAndExpressions::ProhibitFiletest_rwxRWX]
# Bikeshed
[CognitiveComplexity::ProhibitExcessCognitiveComplexity]
warn_level = 40
info_level = 30
[Variables::ProhibitUselessInitialization]
[-ValuesAndExpressions::RequireSlices]
[PreferredModules]
config = .preferred_modules.ini
[logicLAB::RequireSheBang]
formats = #!/usr/bin/env perl
# Performance
[logicLAB::ProhibitShellDispatch]
[ProhibitPipeOpen]
[Performance::ProhibitRegexForSimpleSubstring]
[RegularExpressions::ProhibitRegexToStripAffix]
[RegularExpressions::ProhibitRegexToChomp]
[RegularExpressions::ProhibitRegexToSplitAtDelimiter]
[BuiltinFunctions::ProhibitChainingSameListSub]
[RegularExpressions::ProhibitRegexForStringEquality]
[Subroutines::ProhibitUnderscorePrivateSubs]
[Subroutines::ProhibitSingleUseLexicalSubs]
[ValuesAndExpressions::ProhibitLiteralArithmetic]
[BuiltinFunctions::ProhibitIndirectBooleanGrep]
# What ProhibitMutatingListFunctions reports, which this replaces, and a block
# that changes $_ through a sub that it calls.  Its two call reports stay off,
# because the policy below reports the same calls.
[ControlStructures::ProhibitMutatingListFunctionsStricter]
# A call that it cannot read, a method or a sub from elsewhere, while $_ is the
# caller's element: in a list function block before local ($_) = $_, and
# before a postfix for.
[Variables::ProhibitCallsWithAliasedTopic]
# An if, elsif, else or unless whose block holds no statement, a comment
# being none.  Loops are left alone, because a loop condition can do the work.
[ControlStructures::ProhibitEmptyConditionalBlocks]
# A sub that returns the result of a syscall or an eval, called where nothing
# looks at the result.  The same functions as RequireCheckedSyscalls below.
[ErrorHandling::RequireCheckedIndirectResults]
exclude_functions = print say
[ProhibitUseLib]
[ProhibitUsageSubs]
sub_names = usage _usage print_usage usage_message
[RequireQwForLiteralLists]
[ProhibitNoWarningsRedefine]
[RequireFatalWarnings]
[ProhibitUnusedImports]
allow = Exporter
# Modules imported for a side effect rather than for a symbol, which the policy
# cannot see.  Its built-in list has the pragmas, re, Test::NoWarnings,
# Test2::Plugin::NoWarnings and Mojo::Base.  Add your own with an override of
# allow in .conformance.yml, such as a module that another one loads by the name
# you give it in a string: Text::Xslate takes its bridge as module => [...].
# Off in a distribution that is only a library: it counts calls from bin/ and
# lib/, and every sub a library exists to offer is called from neither -- a
# module with one public sub and no bin/ reports that sub, which is the policy
# working correctly and saying nothing.  Turn it on for a distribution that also
# ships programs, and add the authordep line to dist.ini when you do.
#
# allow_subs then lists the subs that are called in a way it cannot see: named
# in a string and called as $obj->$name, handed to something else that calls
# them, or called only from a directory it does not read.  Name each one and say
# which, so the next person can tell an exemption from an oversight.
#
# [ProhibitUnusedDefinitions]
# allow_subs =
# A sub that only one subclass uses, and a sub that two subclasses define where
# the class above them defines none.  It reads bin/ and lib/ through
# Perl::Critic::Distribution, as ProhibitUnusedDefinitions does, so the two
# share one parse.  A library whose subclasses live in other distributions
# names in allow_subs each hook that only one of its own subclasses uses.
[ProhibitMisplacedMethods]
[ProhibitPrintSTDERR]
[InputOutput::ProhibitRepeatedPrints]
# Perl::Critic's own policies.  only = 1 loads nothing that is not named, so
# each of these has to be, and the ones that are absent are absent on purpose.
#
# Not here, because something above already does the job better:
#   CodeLayout::ProhibitQuotedWordLists         RequireQwForLiteralLists
#   ControlStructures::ProhibitCascadingIfElse  CognitiveComplexity, which
#   ControlStructures::ProhibitDeepNests          scores nesting and every
#   Subroutines::ProhibitExcessComplexity         break in flow, where these
#                                                 count branches
#   ControlStructures::ProhibitMutatingListFunctions
#                                               ProhibitMutatingListFunctionsStricter,
#                                                 which reports all of it, and
#                                                 a sub that the block calls
#   InputOutput::ProhibitBacktickOperators      logicLAB::ProhibitShellDispatch
#   Modules::ProhibitEvilModules                PreferredModules
#   Subroutines::ProhibitUnusedPrivateSubroutines  ProhibitUnusedDefinitions,
#                                                 which counts calls from bin/
#                                                 and lib/, private or not
#   TestingAndDebugging::RequireUseWarnings     RequireFatalWarnings
#   ValuesAndExpressions::ProhibitLeadingZeros  Plicease::ProhibitLeadingZeros
#   Modules::RequireVersionVar                  [PkgVersion] in dist.ini
#   ErrorHandling::RequireCarping               die with context, and
#                                                 Carp::Always for the trace
#
# Nor the five the language enforces under this file's floor.  The header says
# which they are, and perlcriticrc.compat is where they live.
#
# Documentation::RequirePodSections is out as well: the sections it asks for are
# the ones Pod::Weaver writes at build, and weaver.ini names them AUTHORS and
# COPYRIGHT AND LICENSE where the policy wants AUTHOR and LICENSE AND COPYRIGHT.
[BuiltinFunctions::ProhibitBooleanGrep]
[BuiltinFunctions::ProhibitLvalueSubstr]
[BuiltinFunctions::ProhibitReverseSortBlock]
[BuiltinFunctions::ProhibitShiftRef]
[BuiltinFunctions::ProhibitSleepViaSelect]
[BuiltinFunctions::ProhibitStringyEval]
[BuiltinFunctions::ProhibitStringySplit]
[BuiltinFunctions::ProhibitUniversalCan]
[BuiltinFunctions::ProhibitUniversalIsa]
[BuiltinFunctions::ProhibitVoidGrep]
[BuiltinFunctions::ProhibitVoidMap]
[BuiltinFunctions::RequireBlockGrep]
[BuiltinFunctions::RequireBlockMap]
[BuiltinFunctions::RequireGlobFunction]
[BuiltinFunctions::RequireSimpleSortBlock]
[ClassHierarchies::ProhibitAutoloading]
[ClassHierarchies::ProhibitExplicitISA]
[ClassHierarchies::ProhibitOneArgBless]
[CodeLayout::ProhibitHardTabs]
[CodeLayout::ProhibitTrailingWhitespace]
[CodeLayout::RequireConsistentNewlines]
# [CodeLayout::RequireTidyCode] is off on purpose.  git-hooks/pre-commit runs
# perltidy over every staged Perl file before it runs this profile, so every
# commit is tidy whatever this policy would say.  In an editor, the policy only
# repeated that, and ran perltidy over the whole file on every check.
[CodeLayout::RequireTrailingCommas]
[ControlStructures::ProhibitLabelsWithSpecialBlockNames]
[ControlStructures::ProhibitNegativeExpressionsInUnlessAndUntilConditions]
[ControlStructures::ProhibitUnreachableCode]
[ControlStructures::ProhibitUntilBlocks]
[ControlStructures::ProhibitYadaOperator]
[Documentation::PodSpelling]
spell_command = aspell --lang=en_US list
stop_words_file = .pod_stopwords
[Documentation::RequirePackageMatchesPodName]
[ErrorHandling::RequireCheckingReturnValueOfEval]
[InputOutput::ProhibitExplicitStdin]
[InputOutput::ProhibitInteractiveTest]
[InputOutput::ProhibitJoinedReadline]
[InputOutput::ProhibitOneArgSelect]
[InputOutput::ProhibitReadlineInForLoop]
[InputOutput::ProhibitTwoArgOpen]
[InputOutput::RequireBracedFileHandleWithPrint]
[InputOutput::RequireBriefOpen]
[InputOutput::RequireCheckedOpen]
[InputOutput::RequireCheckedSyscalls]
exclude_functions = print say
[InputOutput::RequireEncodingWithUTF8Layer]
[Miscellanea::ProhibitFormats]
[Miscellanea::ProhibitTies]
[Miscellanea::ProhibitUnrestrictedNoCritic]
[Miscellanea::ProhibitUselessNoCritic]
[Modules::ProhibitAutomaticExportation]
[Modules::ProhibitConditionalUseStatements]
[Modules::RequireBarewordIncludes]
[Modules::RequireFilenameMatchesPackage]
[Modules::RequireNoMatchVarsWithUseEnglish]
[NamingConventions::Capitalization]
package_exemptions = main tcms login useradd blob css email html json text
[RegularExpressions::ProhibitCaptureWithoutTest]
[RegularExpressions::ProhibitComplexRegexes]
[RegularExpressions::ProhibitEnumeratedClasses]
[RegularExpressions::ProhibitFixedStringMatches]
[RegularExpressions::ProhibitSingleCharAlternation]
[RegularExpressions::ProhibitUnusedCapture]
[RegularExpressions::RequireBracesForMultiline]
[RegularExpressions::RequireDotMatchAnything]
[RegularExpressions::RequireExtendedFormatting]
[Subroutines::ProhibitAmpersandSigils]
[Subroutines::ProhibitBuiltinHomonyms]
allow = read write delete index shutdown
[Subroutines::ProhibitManyArgs]
[Subroutines::ProhibitNestedSubs]
[Subroutines::ProhibitReturnSort]
[Subroutines::ProhibitSubroutinePrototypes]
[Subroutines::ProtectPrivateSubs]
[Subroutines::RequireArgUnpacking]
[Subroutines::RequireFinalReturn]
terminal_funcs = POSIX::_exit
[TestingAndDebugging::ProhibitProlongedStrictureOverride]
[TestingAndDebugging::RequireTestLabels]
[ValuesAndExpressions::ProhibitCommaSeparatedStatements]
[ValuesAndExpressions::ProhibitComplexVersion]
[ValuesAndExpressions::ProhibitEscapedCharacters]
[ValuesAndExpressions::ProhibitLongChainsOfMethodCalls]
[ValuesAndExpressions::ProhibitMismatchedOperators]
[ValuesAndExpressions::ProhibitMixedBooleanOperators]
[ValuesAndExpressions::ProhibitQuotesAsQuotelikeOperatorDelimiters]
[ValuesAndExpressions::ProhibitSpecialLiteralHeredocTerminator]
[ValuesAndExpressions::ProhibitVersionStrings]
[ValuesAndExpressions::RequireConstantVersion]
[ValuesAndExpressions::RequireQuotedHeredocTerminator]
[ValuesAndExpressions::RequireUpperCaseHeredocTerminator]
[Variables::ProhibitAugmentedAssignmentInDeclaration]
[Variables::ProhibitConditionalDeclarations]
# Variables::ProhibitEvilVariables is not listed: it declines to load until it
# is given variables to prohibit, and nobody has named any.
[Variables::ProhibitLocalVars]
[Variables::ProhibitMatchVars]
[Variables::ProhibitPerl4PackageNames]
[Variables::ProhibitReusedNames]
# Stricter than the core ProhibitUnusedVariables, which reports only a bare
# `my $x;` and misses a variable that is assigned and never read.
[Variables::ProhibitUnusedVarsStricter]
# A method takes the arguments of its interface, whether it reads them or not.
allow_unused_subroutine_arguments = 1
# Anything that returns a guard, which does its work by being held to the end of
# its scope: a mock, a mocked file, or a change of directory that File::pushd
# undoes when the object goes.
allow_if_computed_by = Test::MockModule->new Test::MockFile->file Test::MockFile->file_from_disk Test::MockFile->symlink Test::MockFile->dir Test::MockFile->new_dir pushd tempd
[Variables::ProtectPrivateVars]
[Variables::RequireLexicalLoopIterators]
# A block foreach with no loop variable, whose $_ the body can clobber.
[-Variables::ProhibitTopicIterator]
[Variables::RequireLocalizedPunctuationVars]
[Variables::RequireNegativeIndices]
# A read through a missing level, such as $h{a}{b}, creates $h{a}.  Write
# no autovivification; in the scope, which [AutoPrereqs] then declares.
[-Variables::RequireNoAutovivification]
# Extensions to perl -c
[CompileTime]

# The overrides of .conformance.yml
[ProhibitUnusedDefinitions]
allow_globals = @TCMS::routes %TCMS::aliases
allow_subs = TCMS::generic_route Trog::DataSource::DirIndex::posts Trog::DataSource::DirIndex::order Trog::DataSource::ProvisionedVirt::posts Trog::Enrich::Invoice::enrich Trog::Log::DBI::create_statement Trog::Log::DBI::log_message Trog::Log::Syslog::log_message Trog::Routes::HTML::series Trog::Routes::HTML::users
