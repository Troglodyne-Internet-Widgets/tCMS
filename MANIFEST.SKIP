# What perl Makefile.PL, make and the tests leave in a build, which is not in
# MANIFEST.  This is written out rather than #!include_default: the default
# skips every file named Makefile, and share/nginx-unit/Makefile is part of tCMS.
^Makefile$
^Makefile\.old$
^MYMETA\.
^MANIFEST\.bak$
^blib/
^pm_to_blib$
^pod2htmd\.tmp$
^data/
^logs/
^totp/
^www/assets/
^www/statics/
^www/themes/

# For the people who work on tCMS, not for anyone who installs it.
^CLAUDE\.md$
^git-hooks/

# Read by dzil at the build, which writes what they say into META.json,
# Makefile.PL and the POD.
^dist\.ini$
^weaver\.ini$
^prereqs\.(?:yml|json)$
^metamerge\.(?:yml|json)$

# What Devel::Cover leaves.
^cover_db/
