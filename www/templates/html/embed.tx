<: component('Header', {
    title        => $title,
    route        => $route,
    lang         => $lang,
    author       => $author,
    meta_desc    => $meta_desc,
    meta_tags    => $meta_tags,
    default_tags => $default_tags,
    embed        => $embed,
    stylesheets  => $stylesheets,
    print_styles => $print_styles,
    scripts      => $scripts,
}) :>
:if ($embed_video || $nochrome) {
<style>
.divider, .blogtitles, #postData, .post-tags {
    display:none;
}
video {
    height: unset !important;
    width: 100% !important;
}
</style>
: }

: if (!$embed_video && !$nochrome) {
<div id="kontent" class="kontained">
: }
    <: $content | mark_raw :>
: if (!$embed_video && !$nochrome) {
</div>
: }
<: component('Footer') :>

