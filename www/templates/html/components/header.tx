: if (!$no_doctype) {
<!doctype html>
: }
<html dir="auto" lang="<: $lang :>">
    <head>
        <title><: $title | mark_raw :></title>
        <meta charset="utf-8" />

        <link rel="alternate" title="rss" type="application/rss+xml" href="<: $route :>?format=rss" />
        <link rel="icon" type="image/svg+xml" href="/<: $theme_dir :>/img/icon/favicon.svg" />
        <link rel="apple-touch-icon" type="image/png" sizes="167x167" href="/<: $theme_dir :>/img/icon/favicon-167.png" />
        <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/<: $theme_dir :>/img/icon/favicon-180.png" />
        <link rel="icon" type="image/png" sizes="48x48" href="/<: $theme_dir :>/img/icon/favicon-48.png" />
        <link rel="icon" type="image/png" sizes="192x192" href="/<: $theme_dir :>/img/icon/favicon-192.png" />
        <link rel="manifest" href="/api/webmanifest" />

        : if ($author) {
        <meta name="author" content="<: $author :>"/>
        : }

        : if ($meta_desc) {
        <meta name="description" content="<: $meta_desc :>"/>
        : }
        : if ($default_tags) {
        <meta name="tags" content="<: $default_tags :>" />
        : }
        : if ($meta_tags) {
        <: $meta_tags | mark_raw :>
        : }

        <meta name="viewport" content="width=device-width" />
        : if ($embed) {
        <base target="_blank" />
        <link rel="stylesheet" type="text/css" href="/styles/embed.css" media="screen" />
        : }
        <!-- Stylesheets !-->
        : for $stylesheets -> $stylesheet {
        :   my $sri = sri_hash($stylesheet);
        <link rel="preload" type="text/css" href="<: $stylesheet :>" as="style"<: $sri ? ' integrity="' ~ $sri ~ '"' : '' | mark_raw :> />
        <link rel="stylesheet" type="text/css" href="<: $stylesheet :>" media="screen"<: $sri ? ' integrity="' ~ $sri ~ '"' : '' | mark_raw :> />
        : }
        <!-- Print Styles !-->
        : for $print_styles -> $print_style {
        :   my $sri = sri_hash($print_style);
        <link rel="preload" type="text/css" href="<: $print_style :>" as="style"<: $sri ? ' integrity="' ~ $sri ~ '"' : '' | mark_raw :> />
        <link rel="stylesheet" type="text/css" href="<: $print_style :>" media="print"<: $sri ? ' integrity="' ~ $sri ~ '"' : '' | mark_raw :> />
        : }
        <!-- For highlight.js !-->
        :   my $obsidian_sri = sri_hash("/styles/obsidian.min.css");
        <link rel="preload" type="text/css" href="/styles/obsidian.min.css" as="style"<: $obsidian_sri ? ' integrity="' ~ $obsidian_sri ~ '"' : '' | mark_raw :> />
        <link rel="stylesheet" type="text/css" href="/styles/obsidian.min.css"<: $obsidian_sri ? ' integrity="' ~ $obsidian_sri ~ '"' : '' | mark_raw :> />
        <!-- For reveal.js !-->
        :   my $reveal_sri = sri_hash("/styles/reveal.css");
        <link rel="preload" type="text/css" href="/styles/reveal.css" as="style"<: $reveal_sri ? ' integrity="' ~ $reveal_sri ~ '"' : '' | mark_raw :> />
        <link rel="stylesheet" type="text/css" href="/styles/reveal.css"<: $reveal_sri ? ' integrity="' ~ $reveal_sri ~ '"' : '' | mark_raw :> />
        :   my $reveal_white_sri = sri_hash("/styles/reveal-white.css");
        <link rel="preload" type="text/css" href="/styles/reveal-white.css" as="style"<: $reveal_white_sri ? ' integrity="' ~ $reveal_white_sri ~ '"' : '' | mark_raw :> />
        <link rel="stylesheet" type="text/css" href="/styles/reveal-white.css"<: $reveal_white_sri ? ' integrity="' ~ $reveal_white_sri ~ '"' : '' | mark_raw :> />

        <!-- Javascript !-->
        : for $scripts -> $script {
        :   my $script_sri = sri_hash($script);
        <script type="text/javascript" src="<: $script :>"<: $script_sri ? ' integrity="' ~ $script_sri ~ '"' : '' | mark_raw :>></script>
        : }
    </head>
    <body>
