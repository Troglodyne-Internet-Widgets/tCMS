<!-- Generated by the tCMS Post Type Wizard.  Regenerating this type will overwrite any hand edits. -->
<div class="post <: $style :> <: $tiled ? 'tile' : '' :>">
    : if ( !$post.addpost ) {
        : include "post_title.tx";
        : include "post_tags.tx";
<div class="postData responsive-text">
    Connection URI:<br />
    <a href="<: $post.conn_uri :>"><: $post.conn_uri :></a>
    <br />
    <: render_it($post.data) | mark_raw :>
</div>
    : }

    : if ( $can_edit ) {
        <div class="postedit">
        : include "edit_head.tx";
        <form class="Submissions" action="/post/save" method="POST" enctype="multipart/form-data">
            Title *<br /><input required class="cooltext" type="text" name="title" placeholder="HV Hostname" value="<: $post.title :>" />
            Libvirt Connection URI<br /><input required class="cooltext" type="url" name="conn_uri" placeholder="libvirt://localhost" value="<: $post.conn_uri :>" />
            : include "visibility.tx";
            : include "acls.tx";
            : include "tags.tx";
            : include "aliases.tx";
            : include "form_common.tx";
        </form>
        : include "edit_foot.tx";
        </div>
    : }
</div>
