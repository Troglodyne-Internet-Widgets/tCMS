<!-- Generated by the tCMS Post Type Wizard.  Regenerating this type will overwrite any hand edits. -->
<div class="post <: $style :> <: $tiled ? 'tile' : '' :>">
    : if ( !$post.addpost ) {
        : if ( $post.unreachable ) {
            <h3 class='blogtitles'><: $post.title :></h3>
            <div class="postData responsive-text">
                Could not reach this hypervisor: <: $post.state :>
            </div>
        : } else {
            : if ( $tiled ) {
                <p class="midtitle">
                    <: $post.title :>
                    <span class="tag guest-state guest-<: $post.is_active ? 'up bg-green' : 'down bg-red' :>"><: $post.state :></span>
                    : if ( $post.is_self ) {
                    <span class="guest-state guest-self tag" title="the server tCMS is running on">dom0</span>
                    : }
                </p>
                : # The capture is declared private in guests.json, so a reader
                : # who cannot edit never receives it -- there is nothing here
                : # to remember to guard.
                : if ( $post.preview ) {
                    <a href="<: $post.preview :>" class="undecorated" title="<: $post.title :> (<: $post.state :>)">
                        <img src="<: $post.preview :>" class="responsive-img guest-screenshot" alt="console of <: $post.title :>" loading="lazy" />
                    </a>
                : }
            : } else {
                <h3 class='blogtitles'>
                    <: $post.title :>
                    <span class="tag guest-state guest-<: $post.is_active ? 'up bg-green' : 'down bg-red' :>"><: $post.state :></span>
                    : if ( $post.is_self ) {
                    <span class="guest-state guest-self tag" title="the server tCMS is running on">dom0</span>
                    : }
                </h3>
                <div class="postData responsive-text" id="postData-<: $post.id :>">
                    : if ( $post.preview ) {
                        <a href="<: $post.preview :>" class="undecorated" title="console of <: $post.title :>">
                            <img src="<: $post.preview :>" class="responsive-img guest-screenshot" alt="console of <: $post.title :>" loading="lazy" />
                        </a>
                        <br />
                    : }
                    on <: $post.hypervisor_title :> &mdash; <: $post.vcpus :> vCPU
                    : if ( $can_edit ) {
                    <br />
                    <form class="Submissions guest-actions" action="/guest/act" method="POST">
                        <input type="hidden" name="hypervisor" value="<: $post.hypervisor :>" />
                        <input type="hidden" name="guest" value="<: $post.domain :>" />
                        <input type="hidden" name="to" value="<: $route :>" />
                        : # This guest is the server drawing the page, so the two
                        : # controls that would take it down are not offered.
                        : # Trog::DataSource::Virt::act() refuses them too -- see
                        : # there for why hiding them is not the guard.
                        : if ( !$post.is_self ) {
                        : if ( $post.is_active ) {
                        <button class="coolbutton" type="submit" name="action" value="poweroff">Power Off</button>
                        : } else {
                        <button class="coolbutton" type="submit" name="action" value="poweron">Power On</button>
                        : }
                        : }
                        <button class="coolbutton" type="submit" name="action" value="snapshot">Snapshot</button>
                        : if ( !$post.is_self ) {
                        <button class="coolbutton guest-destroy" type="submit" name="action" value="destroy"
                                onclick="return confirm('Destroy <: $post.title :>?  This stops the guest immediately.');">Destroy</button>
                        : }
                    </form>
                    : }
                </div>
            : }
        : }
    : }
</div>
