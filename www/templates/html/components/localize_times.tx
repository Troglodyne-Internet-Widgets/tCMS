    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function(event) {

            // Fix dates to be localized.  An element with data-time also shows the time of day.
            var timey = document.querySelectorAll('.unixtimestamp');
            for (var e of timey) {
                if (parseInt(e.innerText) != e.innerText) {
                    // Don't do anything.
                    continue;
                }
                var d = new Date(0);
                d.setUTCSeconds(e.innerText);
                if (e.dataset.time) {
                    e.innerHTML = d.toLocaleString();
                    continue;
                }
                e.innerHTML = "&nbsp;" + d.toDateString();
            }
        });
    </script>
